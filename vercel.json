{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo/sitemap"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "optics-shop-skeleton.vercel.app"
        }
      ],
      "destination": "https://pro-optics.com.ua/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "optics-shop-skeleton-jacqros-projects.vercel.app"
        }
      ],
      "destination": "https://pro-optics.com.ua/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/admin/price-sync",
      "schedule": "0 6 * * *"
    }
  ]
}
